# 站点正式域名（sitemap / RSS / canonical 使用）
# 未设置时依次回退到 VERCEL_PROJECT_PRODUCTION_URL → VERCEL_URL → https://soq.app
PUBLIC_SITE_URL=https://soq.app

# 内容源：默认自动探测 <项目根>/public/blogs（应用与内容同仓库），本地开发时回退到同级旧仓库
# CONTENT_SOURCE=

# ---------- 写作控制台（/write）----------
# GitHub App 配置（这些值会打进客户端包，本来就不是秘密；真正的秘密是私钥文件，不入库）
PUBLIC_GITHUB_OWNER=etk3mfalive
PUBLIC_GITHUB_REPO=2025-blog-public
PUBLIC_GITHUB_BRANCH=main
# 在 GitHub App 设置页可以看到 App ID（本站使用的 App 是 sonquain-blog）
PUBLIC_GITHUB_APP_ID=

# 文章内容在仓库里的目录（写作控制台提交到这里，构建时同步进 static/）
PUBLIC_CONTENT_DIR=public/blogs

# 站点配置 / 列表数据在仓库里的位置：
#   new    —— src/lib/data/*.json（本站自己持有，推荐）
#   legacy —— 旧 Next.js 应用的路径（src/config/*.json、src/app/*/list.json）
PUBLIC_SITE_DATA_MODE=new

# 注意：不再需要"加密口令"环境变量。
# 私钥缓存改用你在写作页输入的口令 + PBKDF2 派生密钥（AES-GCM），sessionStorage 里只存密文。

# 点赞后端（保留现有 Worker）
# PUBLIC_LIKE_ENDPOINT=https://blog-liker.yysuni1001.workers.dev/api/like
